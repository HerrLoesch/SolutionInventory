{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solutioninventory.local/schema/catalog.schema.json",
  "title": "Fragenkatalog (Catalog)",
  "description": "Structure of a reusable question catalog template — the Vorlage in docs/spec-fragenkataloge.md §2.1/§3. Serves as documentation and as the basis for the runtime validator in catalogValidation.js; it is not interpreted at runtime.",
  "type": "object",
  "required": ["id", "name", "version", "schemaVersion", "categories"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "statusOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "applicabilityOptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "desc": { "type": "string" },
        "isMetadata": { "type": "boolean" },
        "appliesTo": { "$ref": "#/$defs/appliesTo" },
        "metadata": { "type": "object" },
        "metadataOptions": { "type": "object" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "aspect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "aspect": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "appliesTo": { "$ref": "#/$defs/appliesTo" },
        "defaultApplicability": { "type": "string" },
        "examples": {
          "type": "array",
          "items": { "$ref": "#/$defs/example" }
        }
      }
    },
    "example": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "appliesTo": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
      }
    }
  }
}
